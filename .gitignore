# Python
__pycache__/
*.py[cod]

# Virtual environment
.venv/

# Generated pipeline artifacts -- regenerated by running the scripts,
# no need to track in git (chunks.json/embeddings.npy/faiss.index can
# be rebuilt from data/pdfs/ via chunking.py + vectorstore.py)
data/processed/

# Evaluation results -- regenerated by running evaluate.py
# (questions.json is hand-authored and IS tracked, so this only
# excludes the generated output files)
data/eval/results*.json

# Submission export -- a copy of already-tracked files assembled for
# handing in, not something to version control itself
submission/

# OS junk
.DS_Store
Thumbs.db
